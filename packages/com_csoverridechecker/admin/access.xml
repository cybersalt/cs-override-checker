<?xml version="1.0" encoding="utf-8"?>
<!--
    Cybersalt Override Checker - ACL definitions

    csoverridechecker.view  : may read overrides, sessions, action log, backups (GET endpoints)
    csoverridechecker.write : may apply fixes, dismiss overrides, restore backups, create sessions/backups
                        (write-side endpoints + admin "Restore" / "Apply fix" actions)

    The standard core actions are also defined so site admins can map them
    in the Permissions tab. PermissionHelper also accepts core.manage, so
    on a default Joomla install the Administrator group inherits both
    tiers (core.manage is granted to Administrator at the root asset),
    not only Super Users. Write tier writes PHP files into templates/,
    which is code execution on the server: grant it only where you would
    grant template editing.
-->
<access component="com_csoverridechecker">
    <section name="component">
        <action name="core.admin"   title="JACTION_ADMIN"   description="JACTION_ADMIN_COMPONENT_DESC" />
        <action name="core.manage"  title="JACTION_MANAGE"  description="JACTION_MANAGE_COMPONENT_DESC" />
        <action name="core.options" title="JACTION_OPTIONS" description="JACTION_OPTIONS_COMPONENT_DESC" />

        <action name="csoverridechecker.view"
                title="COM_CSOVERRIDECHECKER_ACTION_VIEW_TITLE"
                description="COM_CSOVERRIDECHECKER_ACTION_VIEW_DESC" />

        <action name="csoverridechecker.write"
                title="COM_CSOVERRIDECHECKER_ACTION_WRITE_TITLE"
                description="COM_CSOVERRIDECHECKER_ACTION_WRITE_DESC" />
    </section>
</access>
